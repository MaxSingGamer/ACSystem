# ============================================================
#  ACSystem 环境配置模板（v4.0.0）
#
#  用法：复制本文件到「各端自己的数据目录」并按需修改：
#    中心服务器：~/.alphacoinserver/<服务接口域名>/.env
#                （由服务中心面板「新建服务」时自动生成，端口/域名已写好）
#    服务中心面板：~/.alphacoinserver/.env（面板根目录下的 .env，只放 ACS_PANEL_* 三项）
#    客户端：v3.3.0 起**不需要 .env** —— 品牌/更新源等由服务端 /api/client/config 下发（#7/D39）
#  也可以用 ACS_DATA_DIR 指定数据目录（见下）。
#
#  设计原则：**所有可定制元素都通过环境变量提供，源码内不写死任何品牌/域名/账号**。
#  未设置或留空的变量一律使用默认值（默认值见每项说明），因此本文件可只填需要改的部分。
# ============================================================


# ============================================================
#  一、品牌与部署定制（仅服务端 .env 生效；客户端从 /api/client/config 取）
# ------------------------------------------------------------
#  品牌名 / 货币符号 / 组织名：同时用于界面文案、协议与隐私政策正文（自动替换）
# ACS_BRAND_NAME=Alpha Coin
# ACS_BRAND_CURRENCY=A€
# ACS_BRAND_UNION_NAME=Alpha Economy Union
# ACS_BRAND_UNION_NAME_CN=阿尔法经济联盟
# ACS_BRAND_UNION_ABBR=AEU
# ACS_BRAND_SYSTEM_NAME=Alpha Coin System

#  应用名：服务端控制台窗口标题 / 客户端窗口标题与 CLI 帮助
# ACS_SERVER_APP_NAME=Alpha Coin Central Server
# ACS_CLIENT_APP_NAME=Alpha Wallet

#  公开地址（服务接口域名，API）：v4.0.0 起它是**唯一识别符**，同时决定服务文件夹名；
#  访问该域名根路径会 302 到下面「后台管理域名」的登录页。
# ACS_PUBLIC_URL=https://acsystem.maxshin.top
#  后台管理域名（网页入口）：仅用于把访问者带到后台登录页 /login，不参与 API。
#  v4.0.0 起两个域名必须不同，且各自全局唯一（面板新建/修改时校验）。
# ACS_ADMIN_URL=https://acsmanage.maxshin.top

#  邮箱域名：系统账户与管理员 gpg 密钥的 User ID 都会带上它们
# ACS_SYSTEM_EMAIL_DOMAIN=maxshin.top
# ACS_ADMIN_EMAIL_DOMAIN=aeu.admin

#  铸造（发行）交易的名义发出方标识：**不能与任何真实账户 UID 同名**
# ACS_MINT_AUTHORITY=MintAuthority

#  自动更新源（GitHub owner/repo）：服务端据此下发客户端更新；客户端只读服务端下发的值
# ACS_UPDATE_REPO=MaxSingGamer/ACSystem


# ============================================================
#  二、账号定义（仅服务端；**必须有 Root 账户，否则拒绝启动**）
# ------------------------------------------------------------
#  格式：
#    ACS_ROOT_ACCOUNTS   = uid:初始密码       （逗号分隔；密码中不可含逗号）
#    ACS_SYSTEM_ACCOUNTS = uid:初始密码       （逗号分隔）
#    PRE_ISSUED_ACCOUNT  = 发行账户 uid       （必须唯一，且必须是 ACS_SYSTEM_ACCOUNTS 之一）
#
#  说明（v3.3.0）：
#    - **Root 账户首启后不可增减**：只有首次建库时按本配置创建，之后不能新增/删除 Root。
#    - **Admin（原「金融部」）不再由 .env 创建**：只能由 Root 在管理后台创建 / 停用（D18）。
#    - 无 ACS_ROOT_ACCOUNTS 或为空 → **拒绝启动**（不再生成默认 admin，D29）。
#    - 密码只存 PBKDF2-HMAC-SHA256 哈希（60 万轮 + 随机盐），不输出明文文件；
#      旧库里的单轮 SHA-256 哈希会在登录成功时自动升级。
#    - 密码不要包含逗号 ","。
#    - 配置了 ACS_SYSTEM_ACCOUNTS 却未正确设置 PRE_ISSUED_ACCOUNT → 拒绝启动并写日志。
#    - 初始密码仅用于首次创建，首次登录会强制改密。
#    - 系统账户的密钥口令密文入库（accounts_system.key_passphrase_enc），
#      后台「进入系统账本账户」时必须输入该口令。
# ============================================================

ACS_ROOT_ACCOUNTS=Max_Shin:ChangeMe123!,Mitrailleur_2905:ChangeMe123!

ACS_SYSTEM_ACCOUNTS=PreIssuedAccount:ChangeMe123!,AESystem:ChangeMe123!,AlphaEU:ChangeMe123!

PRE_ISSUED_ACCOUNT=PreIssuedAccount


# ============================================================
#  三、网络 / 监听（服务端 .env；**端口按部署手动配置，一个服务一套端口**）
# ------------------------------------------------------------
#  数据目录：数据库 / gpg / logs / 本 .env 的存放位置
#    默认 ~/.alphacoinserver/<服务接口域名>（也可用 -homedir 指定）
#    v3.3.0 起根目录名固定为 ~/.alphacoinserver（D33），仅测试可用 ACS_HOME_BASE 改根
# ACS_DATA_DIR=/var/lib/alphacoinserver/acsystem.maxshin.top

#  中心服务名称（D26）：由服务中心面板以 `-name <服务名>` 启动时传入，
#  通过 /api/status 与 /api/client/config 的 service_name 暴露，客户端启动页按名称区分中心（#15）。
#  服务名称**不写入 .env、不写入 AlphaTar 服务包**。手动启动可不传（为空串）。
#  日志文件名（v4.0.0 #7）：由面板以 `-logfile <路径>` 传入；单独启动时自动生成
#  `logs/YYMMDD-HH_mm_SS.alphalog`（本地时间），不再产生 panel-spawn.log。

#  公开 API：客户端访问（ed25519 签名校验 · 同步免 apikey）
#    **无默认端口**：面板新建服务时会写入具体端口；手动启动请显式设置（未设时回退 9600 仅作兼容）
# ACS_PUBLIC_BIND=0.0.0.0
# ACS_PUBLIC_PORT=9600

#  后台管理：网页后台 + 管理 API（/login /root /admin /sys）
#    默认仅本机 127.0.0.1:9680；改为 0.0.0.0 即开放公网
#    （开放公网务必使用强口令，并在反向代理层限制来源 IP）
# ACS_ADMIN_BIND=127.0.0.1
# ACS_ADMIN_PORT=9680

#  网页后台静态资源目录（一般无需设置；默认取可执行文件同级 static/）
# ACS_STATIC_DIR=/opt/acs/server/static

#  ---- 服务中心面板（独立进程 AlphaCoinServerPanel.exe；写在 ~/.alphacoinserver/.env，与各服务的 .env 不是同一个）----
#  v3.3.0 #13/D38：面板与服务进程是**两个 exe**，面板自身只监听一个口（默认 9600/仅本机）
# ACS_PANEL_DOMAIN=面板域名（v4.0.0 起顶栏按它显示 https://<域名>，并作为 Passkey 的 rpId）
# ACS_PANEL_PORT=9600
# ACS_PANEL_BIND=127.0.0.1        # 安全默认只本机（D40）；远程访问请用反向代理 + 认证
#
#  面板登录账户（v4.0.0 Panel #1）：**不在 .env 中配置**。默认 root / ChangeMe123! 硬编码在程序里，
#  首次登录强制同时修改用户名与密码（此后初始密码失效）。账户（含 TOTP/Passkey）保存在
#  ~/.alphacoinserver/panel-account.json（口令只存 PBKDF2 哈希）。
#  TOTP 最多 3 个；开启后「用户名+密码」登录强制 2FA，Passkey 仍可一键登录。
#  Passkey（WebAuthn）需通过面板域名（HTTPS）访问，用裸 IP 无法注册。


# ============================================================
#  四、安全参数（有默认值，一般无需修改）
# ------------------------------------------------------------
#  管理员口令哈希迭代次数（PBKDF2-HMAC-SHA256；下限 10000）
#    越高越安全但登录越慢：60 万轮在 release 构建下约 0.2–0.5 秒
# ACS_PBKDF2_ITERATIONS=600000

#  管理员会话有效期（秒），默认 600（10 分钟待机）
# ACS_TOKEN_TTL_SECS=600

#  主密钥（D8/D10/D15）：**不存在任何 key 文件**。首启为每个 Root 生成一份
#  「Root 口令包裹的拷贝」存库（admin_master_key），Root 登录时在内存解锁；
#  未解锁时访问系统账本相关接口返回 409。无需配置。


# ============================================================
#  五、日志
# ------------------------------------------------------------
#  数据目录 logs/ 下每次启动生成 `YYMMDD-HH_mm_SS.alphalog`（v4.0.0 #7，本地时间）。
#  服务端由面板以 `-logfile` 指定确切文件；面板自身日志在 ~/.alphacoinserver/logs/。
#  保留份数（默认 30）：
# ACS_LOG_KEEP_FILES=30
#
#  升级安装（v4.0.0 #12）：三个安装包都会在安装前自动检测并静默卸载旧版本，
#  只删除程序文件，用户数据目录（~/.alphacoinserver 等）完整保留。
# ============================================================
