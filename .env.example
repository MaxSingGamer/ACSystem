# ============================================================
#  AEU 账户配置模板
#  复制本文件到 ~/.alpha_dir/.env 并按需修改。
# ============================================================
#  格式：
#    ACS_ADMIN_ACCOUNTS = uid:role:初始密码  （多个用逗号分隔；role=root/finance）
#    ACS_SYSTEM_ACCOUNTS = uid:初始密码      （多个用逗号分隔）
#
#  说明：
#    - 存在 ~/.alpha_dir/.env 时：自动禁用默认 admin；
#      管理员/系统账户按下方定义创建，密码只存哈希、不输出 txt。
#    - 不存在时：默认创建 admin（随机密码输出到 SYSTEM_LOGIN_PASSWORDS.txt），
#      且不创建系统账户。
#    - 初始密码仅用于首次登录/首次创建，登录后请立即修改。
#    - 密码不要包含冒号 ":" 或逗号 ","。
# ============================================================

ACS_ADMIN_ACCOUNTS=Max_Shin:root:ChangeMe123!,Mitrailleur_2905:root:ChangeMe123!

ACS_SYSTEM_ACCOUNTS=PreIssuedAccount:ChangeMe123!,AESystem:ChangeMe123!,AlphaEU:ChangeMe123!
