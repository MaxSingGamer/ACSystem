# ============================================================
#  A€ 经济系统（ACSystem）— 敏感文件与本地产物一律不提交
# ============================================================

# ---------- 构建产物 ----------
target/
dist/
build/
build-packages.ps1

# ---------- 本地打包资源（含 Gpg4win 安装器等大文件） ----------
packaging/
gpg4win-*.exe

# ---------- 本地运行数据 / 测试产物（数据库/密钥/日志等敏感内容） ----------
tmp/
*.db
*.db-wal
*.db-shm
logs/
*.log

# ---------- 密钥与证书材料 ----------
master.key
*.key
*.asc
/deploy/certs/key.pem

# ---------- 本地配置（可能含口令） ----------
.env
.env.*
!.env.example
*.local
.venv/

# ---------- 文档源文件与转换脚本（原文迁移到 ../Documents，不入库） ----------
docs/
scripts/
MIGRATION.md
*.alphalog

# ---------- 内部施工记录（不入库） ----------
TODO.md

# ---------- 发布说明 ----------
release-notes/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db